# ==============================================================================
# A&L TALENT + OPENCATS — MODELO DE AMBIENTE DE PRODUÇÃO (.env.production.example)
# ==============================================================================
# INSTRUÇÕES DE SEGURANÇA:
# 1. Copie este arquivo para `.env.production` no servidor:
#    cp .env.production.example .env.production
# 2. Substitua todos os valores de exemplo por segredos criptograficamente fortes.
# 3. NUNCA envie este arquivo preenchido para o repositório Git.
# ==============================================================================

# ─── 1. AMBIENTE DA APLICAÇÃO ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
TZ=America/Sao_Paulo

# ─── 2. BANCO DE DADOS MARIADB 10.11 LTS ──────────────────────────────────────
# No Docker Compose de produção, DB_HOST deve ser 'db' (nome do container interno)
DB_HOST=db
DB_PORT=3306
DB_NAME=cats
DB_USER=ael_prod
DB_PASS=GERE_UMA_SENHA_FORTE_PARA_O_USUARIO_AEL_PROD
DB_ROOT_PASS=GERE_UMA_SENHA_ROOT_EXTREMAMENTE_SEGURA

# ─── 3. SEGREDOS DE SESSÃO & TOKENS HMAC (OBRIGATÓRIO >= 32 CARACTERES) ────────
# Gere chaves criptográficas exclusivas no terminal com:
# openssl rand -hex 32
SESSION_SECRET=COLE_AQUI_A_CHAVE_HEX_GERADA_COM_OPENSSL_PARA_CANDIDATOS
ADMIN_SESSION_SECRET=COLE_AQUI_A_CHAVE_HEX_GERADA_COM_OPENSSL_PARA_RH

# ─── 4. DOMÍNIO, CORS & PROXY REVERSO ──────────────────────────────────────────
# Origem exata do domínio HTTPS oficial (sem barra no final)
CORS_ORIGIN=https://carreiras.aelengenharia.com.br
# Trust Proxy para Nginx (1 = confia no primeiro hop do proxy reverso)
TRUST_PROXY=1

# ─── 5. ARMAZENAMENTO & UPLOADS DE CURRÍCULOS ──────────────────────────────────
# Caminho do volume de upload compartilhado entre API Node.js e OpenCATS PHP
UPLOAD_PATH=/app/opencats/upload

# ─── 6. SERVIÇO DE E-MAIL INSTITUCIONAL (SMTP) ────────────────────────────────
# Configuração para envio de tokens de recuperação de senha e notificações
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rh@aelengenharia.com.br
SMTP_PASS=SENHA_OU_APP_PASSWORD_SMTP
SMTP_FROM="A&L Engenharia — Carreiras" <rh@aelengenharia.com.br>
