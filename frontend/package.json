{
  "name": "ael-talent-portal",
  "version": "1.0.0",
  "description": "Portal de Carreiras A&L Engenharia — Vite + Node.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "lint": "biome check src server",
    "lint:fix": "biome check --write src server",
    "format": "biome format --write src server",
    "test:unit": "vitest run test/unit",
    "test:email": "vitest run test/unit/email.test.js",
    "email:test": "node ../scripts/test-email.js",
    "test:e2e": "playwright test",
    "test:smoke": "node ../scripts/smoke-production.js",
    "test:backup": "node ../scripts/test_backup_restore.js",
    "test:audit": "node test_audit_suite.js",
    "test:hardening": "node test_hardening_suite.js",
    "test:homologation": "node test_homologation_suite.js",
    "test:recruiter": "node test_recruiter_feature.js",
    "test:lifecycle": "node test_complete_lifecycle.js",
    "test:all": "node test_hardening_suite.js && node test_audit_suite.js && node test_homologation_suite.js && node test_recruiter_feature.js && node test_complete_lifecycle.js"
  },


  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "concurrently": "^9.2.4",
    "vite": "^6.3.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.2.0",
    "mysql2": "^3.9.2",
    "nodemailer": "^9.0.5"
  }
}
