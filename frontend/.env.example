# A&L Talent — Frontend/API Environment Configuration (.env.example)
# Copie para frontend/.env e configure conforme o ambiente

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cats
DB_USER=ael_dev
DB_PASS=ael_dev_2024

PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3001,http://localhost:8000

# Chaves de assinatura de sessão / JWT
