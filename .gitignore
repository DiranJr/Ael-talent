# ─── Credenciais e segredos ──────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example

# ─── Docker volumes/persist ──────────────────────────────────────────────────
opencats/docker/persist/
docker/persist/

# ─── Uploads e currículos (dados pessoais reais) ─────────────────────────────
opencats/upload/*
opencats/attachments/*
!opencats/upload/.gitkeep
!opencats/attachments/.gitkeep

# ─── Temporários do OpenCATS ─────────────────────────────────────────────────
opencats/temp/*
!opencats/temp/.gitkeep

# ─── Dependências PHP ────────────────────────────────────────────────────────
opencats/vendor/

# ─── Backups ─────────────────────────────────────────────────────────────────
backups/*
!backups/.gitkeep
*.sql.gz
*.sql.bak

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS / IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Node & Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.next/
scratch/

# ─── OpenCATS config gerado pelo wizard ──────────────────────────────────────
opencats/config.php
# (manter config.php.dist como referência)
