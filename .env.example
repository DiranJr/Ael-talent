# ==============================================================================
# A&L Talent + OpenCATS — Variáveis de Ambiente (.env.example)
# ==============================================================================
# Instruções: Copie este arquivo como `.env` e preencha com as configurações reais.
# NUNCA comite credenciais de produção no repositório Git.

# ─── AMBIENTE & SERVIÇO NODE.JS ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── BANCO DE DADOS MARIADB / OPENCATS ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cats
DB_USER=ael_dev
DB_PASS=sua_senha_segura_aqui
DB_ROOT_PASS=sua_senha_root_aqui

# ─── SEGREDOS DE SESSÃO & TOKENS HMAC ──────────────────────────────────────────
# Gere chaves aleatórias seguras (ex: `openssl rand -hex 32`)
SESSION_SECRET=gere_uma_chave_secreta_com_32_bytes_para_candidatos
ADMIN_SESSION_SECRET=gere_uma_chave_secreta_com_32_bytes_para_rh

# ─── ARMAZENAMENTO & UPLOADS ──────────────────────────────────────────────────
# Caminho absoluto para a pasta compartilhada de upload de currículos
UPLOAD_PATH=./opencats/upload

# ─── POLÍTICA DE CORS ─────────────────────────────────────────────────────────
# Origens permitidas separadas por vírgula (sem barra no final)
CORS_ORIGIN=https://carreiras.aelengenharia.com.br,http://localhost:5173

# ─── SERVIÇO DE E-MAIL (SMTP) — RECURSO FUTURO ────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rh@aelengenharia.com.br
SMTP_PASS=sua_senha_de_app_smtp
SMTP_FROM="A&L Engenharia — Carreiras" <rh@aelengenharia.com.br>

# ─── URLS LOCAIS & SERVIÇOS AUXILIARES ────────────────────────────────────────
APP_URL=http://localhost:8000
PHPMYADMIN_URL=http://localhost:8080
